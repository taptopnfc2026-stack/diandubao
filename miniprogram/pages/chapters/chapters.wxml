<view class="nav">
  <button bindtap="goBack">‹</button>
  <text>{{bookName || '目录'}}</text>
  <view class="nav-spacer"></view>
</view>
<view class="chapter-list">
  <button
    wx:for="{{chapters}}"
    wx:key="id"
    data-index="{{index}}"
    bindtap="openChapter"
  >
    <view>
      <text>{{item.chapter_name || ('第 ' + (index + 1) + ' 课')}}</text>
      <text class="sub">第 {{item.start_page || '-'}}-{{item.end_page || '-'}} 页</text>
    </view>
    <text class="arrow">›</text>
  </button>
</view>
