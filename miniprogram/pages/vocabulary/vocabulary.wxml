<view class="vocabulary-page">
  <nav-bar title="同步背单词" showBack="{{true}}" background="#fff"></nav-bar>

  <scroll-view class="unit-tabs" scroll-x>
    <button
      wx:for="{{units}}"
      wx:key="id"
      class="{{item.id === activeUnitId ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectUnit"
    >{{item.title}}</button>
  </scroll-view>
  <view class="word-list">
    <view wx:for="{{words}}" wx:key="id" class="word-row">
      <view>
        <text class="word">{{item.word}}</text>
        <text class="phonetic">{{item.phonetic}}</text>
        <text class="meaning">{{item.meaning}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <button class="primary sticky-action" bindtap="startStudy">开始学习</button>
</view>
