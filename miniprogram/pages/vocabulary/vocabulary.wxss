.vocabulary-page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.unit-tabs {
  white-space: nowrap;
  padding-bottom: 28rpx;
}

.unit-tabs button {
  display: inline-block;
  min-width: 156rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 36rpx;
  background: #fff;
  color: #647084;
  font-weight: 700;
  box-sizing: border-box;
}

.unit-tabs button.active {
  background: #20a8ff;
  color: #fff;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 140rpx;
}

.word-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(38, 80, 120, 0.04);
  box-sizing: border-box;
}

.word-row > view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.word,
.phonetic,
.meaning {
  display: block;
}

.word {
  font-size: 40rpx;
  font-weight: 800;
  color: #111827;
}

.phonetic {
  color: #20a8ff;
  font-weight: 700;
}

.meaning {
  color: #4b5563;
  font-size: 28rpx;
}

.arrow {
  color: #c8ced8;
  font-size: 48rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.primary {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  width: auto;
  padding: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2db3ff, #1688ff);
  color: #fff;
  font-weight: 800;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(22, 136, 255, 0.3);
}

.primary::after,
.word-row::after,
.unit-tabs button::after {
  display: none;
}
