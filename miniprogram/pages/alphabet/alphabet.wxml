<!-- 字母点读页 -->
<view class="alphabet-page">
  <nav-bar title="26个字母发音" showBack="{{true}}" background="#fff"></nav-bar>

  <view class="alphabet-grid">
    <button wx:for="{{letters}}" wx:key="id" data-index="{{index}}" bindtap="play">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
      <text wx:else>{{item.title}}</text>
    </button>
  </view>
</view>
