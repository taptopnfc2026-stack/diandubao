/* 学习报告页面 */
.report-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.report-content {
  padding: 0 28rpx 42rpx;
}

/* ========== 概览卡片 ========== */
.overview-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
}

.overview-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 0;
  border-radius: 16rpx;
  background: #f8fafc;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 900;
  color: #3b82f6;
  line-height: 1;
}

.overview-label {
  font-size: 22rpx;
  color: #94a3b8;
}

/* ========== 图表卡片 ========== */
.chart-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #1f2937;
}

.chart-tabs {
  display: flex;
  gap: 0;
  border-radius: 999rpx;
  background: #f1f5f9;
  padding: 4rpx;
}

.chart-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #94a3b8;
  transition: all 0.2s;
}

.chart-tab.active {
  background: #3b82f6;
  color: #fff;
  font-weight: 600;
}

.chart-canvas {
  width: 100%;
  height: 480rpx;
}

/* ========== 成就卡片 ========== */
.achievement-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
}

.achievement-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.achievement-icon {
  font-size: 40rpx;
  flex: 0 0 auto;
}

.achievement-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.achievement-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.achievement-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

.achievement-check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #10b981;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 加载中 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 20rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #e2e8f0;
  border-top-color: #3b82f6;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
