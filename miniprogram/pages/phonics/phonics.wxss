/* 自然拼读列表页样式 */
.phonics-page {
  min-height: 100vh;
  background: #fff;
}

.phonics-hero {
  min-height: 368rpx;
  background: linear-gradient(135deg, #36c3ff 0%, #1297ec 100%);
  position: relative;
  overflow: hidden;
}

/* 装饰星星 */
.phonics-hero::before {
  content: "★ ★";
  position: absolute;
  top: 160rpx;
  left: 36rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
  letter-spacing: 12rpx;
  z-index: 1;
}

/* 装饰圆 */
.phonics-hero::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -20rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

/* 导航栏在 hero 内需要透明背景 */
.phonics-hero .nav-bar {
  background: transparent;
}

.phonics-hero-title {
  font-size: 46rpx;
  font-weight: 900;
  color: #fff;
  position: relative;
  z-index: 1;
}

.phonics-hero-content {
  padding: 30rpx 36rpx 58rpx;
  position: relative;
  z-index: 1;
}

.phonics-hero-sub {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.phonics-hero-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #1297ec;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.phonics-panel {
  margin-top: -24rpx;
  padding: 44rpx 30rpx 68rpx;
  padding-bottom: calc(68rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.phonics-group + .phonics-group {
  margin-top: 68rpx;
}

.group-title {
  display: block;
  margin-bottom: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
}

.phonics-chip-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 24rpx;
  row-gap: 28rpx;
}

.phonics-chip-grid button {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 20rpx, rgba(140, 150, 165, 0.18) 22rpx, transparent 24rpx),
    #fff;
  font-size: 32rpx;
  font-weight: 600;
  color: #172033;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  line-height: 72rpx;
}

.phonics-chip-grid button::after {
  display: none;
}
