.nav {
  height: 116rpx;
  padding: 44rpx 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  font-weight: 800;
}

.nav button,
.nav-spacer {
  width: 72rpx;
  height: 72rpx;
}

.book-picker {
  display: grid;
  grid-template-columns: 288rpx 1fr;
  height: calc(100vh - 116rpx);
  background: #fff;
}

.category-list {
  height: 100%;
  background: #f4f4f4;
}

.category-list button {
  width: 100%;
  min-height: 108rpx;
  padding: 24rpx 28rpx;
  background: transparent;
  color: #111827;
  text-align: left;
  font-weight: 500;
}

.category-list button.active {
  background: #fff;
  color: #0aa1f5;
  font-weight: 800;
}

.book-panel {
  height: 100%;
  min-width: 0;
  padding: 32rpx 28rpx 48rpx;
  background: #fff;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 44rpx 24rpx;
}

.book-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #252b36;
}

.cover-frame {
  position: relative;
  width: 232rpx;
  border: 4rpx solid transparent;
  border-radius: 20rpx;
}

.book-option.selected .cover-frame {
  border-color: #1ca8ff;
}

.book-option image,
.cover-empty {
  width: 100%;
  height: 310rpx;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 24rpx rgba(42, 65, 93, 0.14);
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f9;
  color: #7c8797;
}

.book-option text {
  font-size: 28rpx;
  font-weight: 700;
}

.checkmark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #24aaf6;
  color: #fff;
  font-weight: 900;
  box-shadow: 0 4rpx 16rpx rgba(36, 170, 246, 0.32);
}
