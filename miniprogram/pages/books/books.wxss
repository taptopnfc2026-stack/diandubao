/* 选择教材页样式 */
.books-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.book-picker {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  background: #fff;
}

/* 左侧分类栏 */
.category-list {
  flex: 0 0 180rpx;
  width: 180rpx;
  background: #f7f8fa;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.category-list button {
  position: relative;
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 18rpx;
  background: transparent;
  color: #6b7280;
  text-align: center;
  font-weight: 500;
  font-size: 24rpx;
  box-sizing: border-box;
  line-height: 1.35;
  white-space: normal;
}

.category-list button::after {
  display: none;
}

.category-list button.active {
  background: #fff;
  color: #0aa1f5;
  font-weight: 800;
}

.category-list button.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 36rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: #0aa1f5;
}

/* 右侧教材面板 */
.book-panel {
  flex: 1;
  min-width: 0;
  padding: 24rpx 24rpx 0;
  background: #fff;
  box-sizing: border-box;
}

.panel-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.3;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx 16rpx;
}

.book-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  background: transparent;
  box-sizing: border-box;
}

.cover-frame {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.book-option.selected .cover-frame {
  box-shadow: 0 0 0 4rpx #24aaf6;
}

.cover-ratio {
  position: relative;
  width: 100%;
  padding-bottom: 133%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f4f6f9;
  box-shadow: 0 8rpx 20rpx rgba(42, 65, 93, 0.1);
}

.cover-ratio image,
.cover-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.book-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.checkmark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #24aaf6;
  color: #fff;
  font-weight: 900;
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(36, 170, 246, 0.35);
}

.panel-bottom {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
