/* 点读学习页样式 */
.reader-page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 导航栏右侧目录按钮（已移到 meta 行，保留类名兼容） */
.nav-catalog-btn,
.catalog-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(10, 161, 245, 0.08);
  color: #0aa1f5;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.nav-catalog-arrow,
.catalog-arrow {
  font-size: 32rpx;
  font-weight: 800;
  color: #0aa1f5;
  margin-left: 2rpx;
}

.reader-meta {
  height: 80rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  box-sizing: border-box;
  flex-shrink: 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.reader-meta .book-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
}

.meta-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.page-indicator {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}

/* Swiper 滑动翻页 */
.reader-swiper {
  flex: 1;
  width: 100%;
  height: 100%;
  background: #fff;
}

.page-item,
.page-scroll {
  height: 100%;
  width: 100%;
}

.page-wrap {
  width: 100%;
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-stage {
  position: relative;
  width: 100%;
  overflow: visible;
}

.page-image {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
}

.page-loading {
  height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c8797;
  font-size: 28rpx;
}

.tap-layer {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 5;
}

.tap-region {
  position: absolute;
  z-index: 6;
  border: 1rpx solid rgba(38, 168, 245, 0.5);
  background: rgba(38, 168, 245, 0.02);
}

.missing-page {
  height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c8797;
  font-size: 28rpx;
}

.reader-controls {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 80rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 32rpx rgba(30, 40, 55, 0.06);
  box-sizing: border-box;
  z-index: 50;
}

.tool-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #172033;
  font-weight: 700;
  background: transparent;
  min-width: 0;
}

.tool-button::after {
  display: none;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4d525a;
  font-size: 52rpx;
}

.tool-button text:last-child {
  font-size: 24rpx;
}
