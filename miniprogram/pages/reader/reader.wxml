<view class="reader-nav">
  <button class="back-button" bindtap="goBack">‹</button>
  <text>点读学习</text>
  <view class="mini-capsule">
    <text>•••</text>
    <view></view>
    <text>—</text>
    <text>○</text>
  </view>
</view>
<view class="reader-meta">
  <text>{{bookName}}</text>
  <button bindtap="openChapters">目录 ›</button>
</view>
<view class="reader">
  <view wx:if="{{page && page.bg_img}}" class="page-wrap">
    <image class="page-image" src="{{page.bg_img}}" mode="widthFix" bindload="onImageLoad" />
    <view class="tap-layer">
      <button
        wx:for="{{regions}}"
        wx:key="id"
        class="tap-region"
        data-index="{{index}}"
        bindtap="playRegion"
        style="left:{{item.rect.left}}px;top:{{item.rect.top}}px;width:{{item.rect.width}}px;height:{{item.rect.height}}px"
      ></button>
    </view>
  </view>
  <view wx:else class="missing-page">暂无页面图片</view>
</view>
<view class="reader-controls">
  <button class="tool-button" bindtap="replay">
    <text class="tool-icon">↻</text>
    <text>复读</text>
  </button>
  <button class="promo-button" bindtap="replay">
    <text class="promo-face"></text>
    <text class="promo-label">免费领英语资料</text>
  </button>
  <button class="tool-button" bindtap="playAll">
    <text class="tool-icon">☵</text>
    <text>连读</text>
  </button>
</view>
