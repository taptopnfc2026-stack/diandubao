/* 自然拼读详情页样式 */
.phonics-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.phonics-detail-head {
  padding: 24rpx 32rpx 30rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  box-sizing: border-box;
  flex-shrink: 0;
}

.letter-row-wrap {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.phonics-scroll-row {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.phonics-scroll-row button {
  display: inline-block;
  width: 104rpx;
  height: 60rpx;
  margin-right: 24rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 20rpx, rgba(140, 150, 165, 0.18) 22rpx, transparent 24rpx),
    #fff;
  color: #172033;
  font-size: 30rpx;
  line-height: 60rpx;
  box-sizing: border-box;
}

.phonics-scroll-row button::after {
  display: none;
}

.phonics-scroll-row button.active {
  border-color: #20a8ff;
  color: #20a8ff;
}

.expand-btn {
  flex: 0 0 auto;
  height: 60rpx;
  padding: 0 4rpx 0 10rpx;
  background: transparent;
  color: #7c8797;
  font-size: 28rpx;
  line-height: 60rpx;
}

.expand-btn::after {
  display: none;
}

.sound-row {
  margin-top: 20rpx;
  white-space: nowrap;
}

.sound-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 56rpx;
  margin-right: 18rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  background: #f0f1f3;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 56rpx;
}

.sound-row button.active {
  background: #20a8ff;
  color: #fff;
  font-weight: 800;
}

.sound-row button::after {
  display: none;
}

.phonics-detail-body {
  flex: 1;
  min-height: 0;
  padding: 46rpx 28rpx calc(68rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-tabs {
  display: flex;
  width: 100%;
  max-width: 430rpx;
  margin-bottom: 34rpx;
}

.detail-tabs button {
  flex: 1;
  position: relative;
  height: 68rpx;
  background: transparent;
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  min-width: 0;
  line-height: 68rpx;
}

.detail-tabs button::after {
  display: none;
}

.detail-tabs button.active::after {
  content: "";
  position: absolute;
  left: 34%;
  right: 34%;
  bottom: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: #20a8ff;
}

.mouth-panel,
.step-list,
.phonics-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mouth-figure {
  position: relative;
  width: 100%;
  max-width: 580rpx;
  margin: 0 auto 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e8f8ff;
  box-sizing: border-box;
}

.mouth-figure image {
  display: block;
  width: 100%;
  height: 392rpx;
}

.floating-audio {
  position: absolute;
  right: 24rpx;
  bottom: 28rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 0;
  background: transparent;
  color: #20a8ff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.method-pill {
  width: 248rpx;
  height: 72rpx;
  margin: 0 auto;
  border: 1rpx solid #20a8ff;
  border-radius: 36rpx;
  background: #fff;
  color: #20a8ff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.method-pill::after {
  display: none;
}

.step-card,
.word-card,
.sentence-card {
  padding: 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
}

.step-card text {
  display: block;
  margin-bottom: 16rpx;
  color: #20a8ff;
  font-weight: 800;
  font-size: 26rpx;
}

.step-card view {
  line-height: 1.6;
  color: #172033;
  font-size: 28rpx;
}

.word-card {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.word-card image {
  flex: 0 0 148rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 16rpx;
}

.word-card view,
.sentence-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.word-card view text:first-child,
.sentence-card text:first-child {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.word-card button,
.sentence-card button {
  align-self: flex-start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef8ff;
  color: #168ed2;
  font-size: 26rpx;
  min-width: 0;
}

.word-card button::after,
.sentence-card button::after {
  display: none;
}

.sentence-card view {
  color: #6b7280;
  font-size: 26rpx;
}

.audio-row {
  display: flex;
  gap: 16rpx;
}
