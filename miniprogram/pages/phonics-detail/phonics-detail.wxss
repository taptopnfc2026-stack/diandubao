@import "../reader/reader.wxss";

.compact-nav {
  height: 116rpx;
  padding-top: 0;
}

.phonics-detail-head {
  padding: 24rpx 32rpx 32rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.phonics-scroll-row {
  white-space: nowrap;
}

.phonics-scroll-row button {
  display: inline-block;
  width: 104rpx;
  height: 60rpx;
  margin-right: 24rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 20rpx, rgba(140, 150, 165, 0.18) 22rpx, transparent 24rpx),
    #fff;
  color: #172033;
  font-size: 30rpx;
}

.phonics-scroll-row button.active {
  border-color: #20a8ff;
  color: #20a8ff;
}

.phonics-scroll-row text {
  color: #7c8797;
  font-size: 28rpx;
}

.sound-badge {
  display: grid;
  width: 104rpx;
  height: 56rpx;
  margin-top: 20rpx;
  place-items: center;
  border-radius: 28rpx;
  background: #20a8ff;
  color: #fff;
}

.phonics-detail-body {
  padding: 56rpx 28rpx 68rpx;
  background: #f5f5f5;
}

.detail-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  width: 520rpx;
  margin-bottom: 36rpx;
}

.detail-tabs button {
  position: relative;
  height: 68rpx;
  background: transparent;
  color: #172033;
  font-size: 36rpx;
  font-weight: 700;
}

.detail-tabs button.active::after {
  content: "";
  position: absolute;
  left: 34%;
  right: 34%;
  bottom: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: #20a8ff;
}

.mouth-panel,
.step-list,
.phonics-list {
  display: grid;
  gap: 24rpx;
}

.mouth-figure {
  position: relative;
  width: 580rpx;
  margin: 0 auto 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e8f8ff;
}

.mouth-figure image {
  display: block;
  width: 580rpx;
  height: 360rpx;
}

.floating-audio {
  position: absolute;
  right: 24rpx;
  bottom: 28rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  color: #20a8ff;
}

.method-pill {
  width: 248rpx;
  height: 72rpx;
  margin: 0 auto;
  border: 1rpx solid #20a8ff;
  border-radius: 36rpx;
  background: #fff;
  color: #20a8ff;
}

.step-card,
.word-card,
.sentence-card {
  padding: 32rpx;
  border-radius: 12rpx;
  background: #fff;
}

.step-card text {
  display: block;
  margin-bottom: 16rpx;
  color: #20a8ff;
  font-weight: 800;
}

.step-card view {
  line-height: 1.6;
}

.word-card {
  display: grid;
  grid-template-columns: 148rpx 1fr;
  gap: 24rpx;
  align-items: center;
}

.word-card image {
  width: 148rpx;
  height: 148rpx;
  border-radius: 12rpx;
}

.word-card view,
.sentence-card {
  display: grid;
  gap: 16rpx;
}

.word-card button,
.sentence-card button {
  justify-self: start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef8ff;
  color: #168ed2;
  font-size: 26rpx;
}

.sentence-card view {
  color: #6b7280;
}

.audio-row {
  display: flex;
  gap: 16rpx;
}
