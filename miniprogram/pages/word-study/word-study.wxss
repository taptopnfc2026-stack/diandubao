.word-study-page {
  min-height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
}

.study-page,
.result-page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.study-progress {
  margin-bottom: 24rpx;
  color: #7c8797;
  text-align: center;
  font-weight: 700;
}

.study-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(38, 80, 120, 0.06);
  box-sizing: border-box;
}

.study-word {
  font-size: 68rpx;
  font-weight: 900;
  text-align: center;
  color: #111827;
}

.phonetic {
  color: #20a8ff;
  text-align: center;
  font-weight: 700;
}

.meaning {
  color: #172033;
  font-size: 36rpx;
  text-align: center;
}

.audio-button {
  width: 184rpx;
  height: 68rpx;
  margin: 0 auto;
  border-radius: 34rpx;
  background: #eef8ff;
  color: #168ed2;
  font-weight: 700;
  box-sizing: border-box;
}

.audio-button::after {
  display: none;
}

.example {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  text-align: center;
  box-sizing: border-box;
  color: #4b5563;
}

.primary {
  width: 100%;
  padding: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2db3ff, #1688ff);
  color: #fff;
  font-weight: 800;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(22, 136, 255, 0.3);
}

.primary::after {
  display: none;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.choice-list button {
  padding: 28rpx 32rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #fff;
  text-align: left;
  font-weight: 700;
  box-sizing: border-box;
  min-width: 0;
}

.choice-list button::after {
  display: none;
}

.choice-list button.correct {
  border-color: #20c77a;
  background: #eafff4;
  color: #088a50;
}

.choice-list button.wrong {
  border-color: #ff6b6b;
  background: #fff0f0;
  color: #d92d20;
}

.label {
  color: #7c8797;
  text-align: center;
  font-size: 28rpx;
}

.spell-input {
  height: 96rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
  box-sizing: border-box;
  width: 100%;
  font-size: 32rpx;
}

.spelling-hint {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #d46b08;
  text-align: center;
  font-weight: 800;
  box-sizing: border-box;
}

.result-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
  padding: 104rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.celebration {
  font-size: 116rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #111827;
}

.result-card {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(38, 80, 120, 0.06);
  box-sizing: border-box;
}

.result-card text {
  width: calc(50% - 12rpx);
  font-size: 28rpx;
  color: #4b5563;
}

.result-card text:nth-child(even) {
  text-align: right;
  font-weight: 800;
  color: #111827;
}
