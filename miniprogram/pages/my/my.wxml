<view class="my-page">
  <view class="my-header">
    <text>我的</text>
    <view class="mini-capsule" aria-label="小程序菜单">
      <text>•••</text>
      <view class="capsule-line"></view>
      <view class="capsule-dot"></view>
      <view class="capsule-ring"></view>
    </view>
  </view>

  <view class="profile-card">
    <view class="avatar-face"><view></view></view>
    <view class="profile-copy">
      <text>{{profile.user.title}}</text>
      <text>{{profile.user.subtitle}}</text>
    </view>
    <button bindtap="loginPreview">{{profile.user.registered ? '已登录' : '立即登录'}}</button>
  </view>

  <view class="usage-card">
    <view class="card-title">
      <text>我的使用时长</text>
      <text>明细 ›</text>
    </view>
    <view class="usage-content">
      <view class="usage-ring" style="background: conic-gradient(#24a9ff {{ringDeg}}deg, #eaf4ff 0deg);">
        <view>
          <text>{{profile.usage.remainingMinutes}}</text>
          <text>分钟</text>
        </view>
      </view>
      <view class="usage-info">
        <text>今日已用 {{profile.usage.usedMinutesToday}} 分钟</text>
        <view class="usage-bar"><view style="width: {{usagePercent}}%;"></view></view>
        <text>{{profile.usage.usedMinutesToday}}/{{profile.usage.totalMinutesToday}} 分钟</text>
        <view class="usage-actions">
          <button bindtap="openInviteTask"><text>＋</text><text>邀请好友</text><text class="action-reward">+{{profile.settings.inviteRewardMinutes}}分钟</text></button>
          <button bindtap="openAdTask"><text>▶</text><text>观看广告</text><text class="action-reward">+{{profile.settings.adRewardMinutes}}分钟</text></button>
        </view>
      </view>
    </view>
  </view>

  <button class="member-card" bindtap="openMemberTask">
    <text>♕</text>
    <view>
      <text>兑换会员</text>
      <text>开通会员，畅享更多权益</text>
    </view>
    <text>立即兑换 ›</text>
  </button>

  <view class="my-menu">
    <button wx:for="{{menuItems}}" wx:key="title" bindtap="noop">
      <text class="menu-icon {{item.icon}}"></text>
      <text>{{item.title}}</text>
      <text>{{item.aside}}</text>
      <text>›</text>
    </button>
  </view>
</view>

<view wx:if="{{showTimeLimitPrompt}}" class="time-limit-mask">
  <view class="time-limit-card">
    <button class="time-limit-close" bindtap="closeTimeLimitPrompt">×</button>
    <view class="time-limit-hero">
      <view class="time-limit-avatar"><view></view></view>
      <view class="time-limit-copy">
        <view class="time-limit-heading">
          <text>免费时长</text>
          <text>已用完</text>
        </view>
        <text class="time-limit-subtitle">{{timeLimitPrompt.subtitle}}</text>
        <text class="time-limit-pill">⏱ {{timeLimitPrompt.message}}</text>
      </view>
    </view>

    <view class="time-limit-title">做任务获取更多时长</view>

    <view class="time-limit-actions">
      <button bindtap="openInviteTask">
        <text class="limit-icon invite">＋</text>
        <view>
          <text>邀请好友</text>
          <text>每成功邀请1位好友</text>
        </view>
        <view class="limit-task-side">
          <text class="limit-reward">+{{timeLimitPrompt.inviteRewardMinutes}} 分钟</text>
          <text class="limit-action">去邀请</text>
        </view>
      </button>
      <button bindtap="openAdTask">
        <text class="limit-icon ad">▶</text>
        <view>
          <text>观看广告</text>
          <text>观看完整视频广告</text>
        </view>
        <view class="limit-task-side">
          <text class="limit-reward">+{{timeLimitPrompt.adRewardMinutes}} 分钟</text>
          <text class="limit-action purple">去观看</text>
        </view>
      </button>
    </view>

    <view class="time-limit-divider"><text>或</text></view>

    <button class="time-limit-member" bindtap="openMemberTask">
      <text class="limit-icon crown">♕</text>
      <view>
        <text>{{timeLimitPrompt.memberTitle}}</text>
        <text>{{timeLimitPrompt.memberSubtitle}}</text>
      </view>
      <text>立即开通</text>
    </button>

    <view class="time-limit-safe">◆ 安全可靠，家长放心</view>
  </view>
</view>

<view wx:if="{{taskView}}" class="task-mask">
  <view class="task-sheet">
    <button class="task-close" bindtap="closeTaskView">×</button>
    <block wx:if="{{taskView == 'invite'}}">
      <view class="task-hero">
        <text class="task-icon invite">＋</text>
        <view>
          <text>邀请好友</text>
          <text>+{{profile.settings.inviteRewardMinutes}} 分钟</text>
        </view>
      </view>
      <view class="task-copy">分享点读助手给好友，好友完成登录 / 注册后即可获得奖励时长。</view>
      <view class="task-steps">
        <text>1. 分享邀请海报或口令</text>
        <text>2. 好友完成登录 / 注册</text>
        <text>3. 系统发放免费时长</text>
      </view>
      <button class="task-primary" bindtap="completeInviteTask">模拟邀请成功</button>
    </block>
    <block wx:elif="{{taskView == 'ad'}}">
      <view class="task-hero">
        <text class="task-icon ad">▶</text>
        <view>
          <text>观看广告</text>
          <text>+{{profile.settings.adRewardMinutes}} 分钟</text>
        </view>
      </view>
      <view class="task-copy">观看完整激励视频广告后，可继续使用点读和练习功能。</view>
      <view class="task-video">广告视频预览位</view>
      <button class="task-primary purple" bindtap="completeAdTask">完成观看并领取</button>
    </block>
    <block wx:else>
      <view class="task-hero">
        <text class="task-icon crown">♕</text>
        <view>
          <text>开通会员</text>
          <text>学习不受限</text>
        </view>
      </view>
      <view class="task-copy">开通会员后可不受免费时长限制，后续可扩展教材包和学习报告权益。</view>
      <view class="task-member-card">
        <text>会员无限使用</text>
        <text>适合长期学习英语点读</text>
      </view>
      <button class="task-primary gold" bindtap="completeMemberTask">模拟开通会员</button>
    </block>
  </view>
</view>

<view class="bottom-tabbar">
  <button bindtap="goHome">
    <text class="tab-icon">⌂</text>
    <text>首页</text>
  </button>
  <button bindtap="startReader">
    <text class="tab-icon">▣</text>
    <text>点读</text>
  </button>
  <button class="active">
    <text class="tab-icon">○</text>
    <text>我的</text>
  </button>
</view>
