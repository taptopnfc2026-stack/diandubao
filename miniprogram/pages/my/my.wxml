<view class="my-page">
  <view class="my-header">
    <text>我的</text>
    <view class="mini-capsule" aria-label="小程序菜单">
      <text>•••</text>
      <view class="capsule-line"></view>
      <view class="capsule-dot"></view>
      <view class="capsule-ring"></view>
    </view>
  </view>

  <view class="profile-card">
    <view class="avatar-face"><view></view></view>
    <view class="profile-copy">
      <text>{{profile.user.title}}</text>
      <text>{{profile.user.subtitle}}</text>
    </view>
    <button bindtap="loginPreview">{{profile.user.registered ? '已登录' : '立即登录'}}</button>
  </view>

  <view class="usage-card">
    <view class="card-title">
      <text>我的使用时长</text>
      <text>明细 ›</text>
    </view>
    <view class="usage-content">
      <view class="usage-ring" style="background: conic-gradient(#24a9ff {{ringDeg}}deg, #eaf4ff 0deg);">
        <view>
          <text>{{profile.usage.remainingMinutes}}</text>
          <text>分钟</text>
        </view>
      </view>
      <view class="usage-info">
        <text>今日已用 {{profile.usage.usedMinutesToday}} 分钟</text>
        <view class="usage-bar"><view style="width: {{usagePercent}}%;"></view></view>
        <text>{{profile.usage.usedMinutesToday}}/{{profile.usage.totalMinutesToday}} 分钟</text>
        <view class="usage-actions">
          <button bindtap="claimInviteReward"><text>＋</text><text>邀请好友</text><text class="action-reward">+{{profile.settings.inviteRewardMinutes}}分钟</text></button>
          <button bindtap="claimAdReward"><text>▶</text><text>观看广告</text><text class="action-reward">+{{profile.settings.adRewardMinutes}}分钟</text></button>
        </view>
      </view>
    </view>
  </view>

  <button class="member-card" bindtap="openMember">
    <text>♕</text>
    <view>
      <text>兑换会员</text>
      <text>开通会员，畅享更多权益</text>
    </view>
    <text>立即兑换 ›</text>
  </button>

  <view class="my-menu">
    <button wx:for="{{menuItems}}" wx:key="title" bindtap="noop">
      <text class="menu-icon {{item.icon}}"></text>
      <text>{{item.title}}</text>
      <text>{{item.aside}}</text>
      <text>›</text>
    </button>
  </view>
</view>

<view wx:if="{{showTimeLimitPrompt}}" class="time-limit-mask">
  <view class="time-limit-card">
    <button class="time-limit-close" bindtap="closeTimeLimitPrompt">×</button>
    <view class="time-limit-hero">
      <view class="time-limit-avatar"><view></view></view>
      <view class="time-limit-copy">
        <view class="time-limit-heading">
          <text>免费时长</text>
          <text>已用完</text>
        </view>
        <text class="time-limit-subtitle">{{timeLimitPrompt.subtitle}}</text>
        <text class="time-limit-pill">⏱ {{timeLimitPrompt.message}}</text>
      </view>
    </view>

    <view class="time-limit-title">做任务获取更多时长</view>

    <view class="time-limit-actions">
      <button bindtap="claimInviteReward">
        <text class="limit-icon invite">＋</text>
        <view>
          <text>邀请好友</text>
          <text>每成功邀请1位好友</text>
        </view>
        <text class="limit-reward">+{{timeLimitPrompt.inviteRewardMinutes}} 分钟</text>
        <text class="limit-action">去邀请</text>
      </button>
      <button bindtap="claimAdReward">
        <text class="limit-icon ad">▶</text>
        <view>
          <text>观看广告</text>
          <text>观看完整视频广告</text>
        </view>
        <text class="limit-reward">+{{timeLimitPrompt.adRewardMinutes}} 分钟</text>
        <text class="limit-action purple">去观看</text>
      </button>
    </view>

    <view class="time-limit-divider"><text>或</text></view>

    <button class="time-limit-member" bindtap="openMember">
      <text class="limit-icon crown">♕</text>
      <view>
        <text>{{timeLimitPrompt.memberTitle}}</text>
        <text>{{timeLimitPrompt.memberSubtitle}}</text>
      </view>
      <text>立即开通</text>
    </button>

    <view class="time-limit-safe">◆ 安全可靠，家长放心</view>
  </view>
</view>

<view class="bottom-tabbar">
  <button bindtap="goHome">
    <text class="tab-icon">⌂</text>
    <text>首页</text>
  </button>
  <button bindtap="startReader">
    <text class="tab-icon">▣</text>
    <text>点读</text>
  </button>
  <button class="active">
    <text class="tab-icon">○</text>
    <text>我的</text>
  </button>
</view>
