page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background:
    radial-gradient(circle at 18% 6%, rgba(169, 237, 255, 0.86), transparent 34%),
    linear-gradient(180deg, #e9f8ff 0%, #f7f8fa 48%, #f7f8fa 100%);
}

.my-page {
  padding: 34rpx 28rpx 42rpx;
}

.my-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.my-header > text {
  font-size: 34rpx;
  font-weight: 900;
  color: #101828;
}

.mini-capsule {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.mini-capsule .capsule-line {
  width: 2rpx;
  height: 28rpx;
  background: #d7dde6;
}

.mini-capsule .capsule-dot,
.mini-capsule .capsule-ring {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #111827;
  border-radius: 50%;
}

.mini-capsule .capsule-ring {
  width: 16rpx;
  height: 16rpx;
  border-width: 3rpx;
}

.profile-card,
.usage-card,
.my-menu {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
}

.profile-card {
  display: grid;
  grid-template-columns: 96rpx 1fr auto;
  gap: 22rpx;
  align-items: center;
  min-height: 142rpx;
  padding: 24rpx 28rpx;
}

.avatar-face {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(160deg, #ffe0c9 0%, #fff3df 54%, #76d7ff 55%);
}

.avatar-face::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 14rpx;
  width: 42rpx;
  height: 30rpx;
  border-radius: 50% 50% 46% 46%;
  background: #6d351f;
}

.avatar-face view {
  position: absolute;
  left: 30rpx;
  top: 38rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 0 0 18rpx 18rpx;
  border-bottom: 4rpx solid #d96d5f;
}

.profile-copy {
  display: grid;
  gap: 8rpx;
}

.profile-copy text:first-child {
  font-size: 30rpx;
  font-weight: 900;
  color: #121826;
}

.profile-copy text:last-child {
  font-size: 22rpx;
  color: #667085;
}

.profile-card button {
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #4cc6ff, #1688ff);
}

.profile-card button::after,
.member-card::after,
.my-menu button::after,
.bottom-tabbar button::after,
.usage-actions button::after {
  display: none;
}

.usage-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 28rpx;
}

.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.card-title text:first-child {
  font-weight: 900;
  color: #1f2937;
}

.card-title text:last-child {
  color: #98a2b3;
}

.usage-content {
  display: grid;
  grid-template-columns: 142rpx 1fr;
  gap: 34rpx;
  align-items: center;
  margin-top: 24rpx;
}

.usage-ring {
  display: grid;
  place-items: center;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
}

.usage-ring view {
  display: grid;
  place-items: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fff;
}

.usage-ring text:first-child {
  font-size: 40rpx;
  font-weight: 900;
}

.usage-ring text:last-child {
  font-size: 20rpx;
}

.usage-info {
  display: grid;
  gap: 14rpx;
  color: #344054;
  font-size: 22rpx;
}

.usage-bar {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #edf5ff;
}

.usage-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #24a9ff, #118cff);
}

.usage-info > text:nth-child(3) {
  justify-self: end;
}

.usage-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.usage-actions button {
  display: grid;
  gap: 4rpx;
  justify-items: center;
  min-height: 74rpx;
  padding: 10rpx;
  border-radius: 14rpx;
  color: #253044;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  background: linear-gradient(135deg, #eef9ff, #f3f5ff);
}

.usage-actions text {
  color: #168ff3;
}

.usage-actions .action-reward {
  color: #3b4657;
  font-size: 20rpx;
  font-weight: 600;
}

.member-card {
  display: grid;
  grid-template-columns: 48rpx 1fr auto;
  gap: 16rpx;
  align-items: center;
  width: 100%;
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  color: #7a4a09;
  text-align: left;
  background: linear-gradient(90deg, #fff8e8, #fff1d4);
}

.member-card > text:first-child {
  display: grid;
  place-items: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #f7a91b;
  background: #fff;
}

.member-card view {
  display: grid;
  gap: 4rpx;
}

.member-card view text:first-child {
  font-size: 24rpx;
  font-weight: 900;
}

.member-card view text:last-child,
.member-card > text:last-child {
  font-size: 20rpx;
}

.my-menu {
  margin-top: 22rpx;
  overflow: hidden;
}

.my-menu button {
  display: grid;
  grid-template-columns: 38rpx 1fr auto 24rpx;
  gap: 18rpx;
  align-items: center;
  width: 100%;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eef1f5;
  color: #1f2937;
  text-align: left;
  font-size: 25rpx;
  font-weight: 700;
  background: #fff;
}

.my-menu button:last-child {
  border-bottom: 0;
}

.my-menu button > text:nth-child(3) {
  color: #ff7a2d;
  font-size: 22rpx;
  font-weight: 600;
}

.my-menu button > text:last-child {
  color: #98a2b3;
}

.menu-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  color: #20b5ff;
}

.menu-icon.gift {
  color: #ff7a2d;
}

.menu-icon.coin {
  color: #ff7a2d;
  border-radius: 50%;
}

.menu-icon.clock,
.menu-icon.gear {
  color: #6c82ff;
  border-radius: 50%;
}

.menu-icon.chart,
.menu-icon.card {
  color: #22cfc5;
}

.bottom-tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 22rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(38, 80, 120, 0.16);
}

.bottom-tabbar button {
  display: grid;
  gap: 4rpx;
  justify-items: center;
  padding: 12rpx 0;
  border-radius: 22rpx;
  color: #6f7b8c;
  font-size: 22rpx;
  line-height: 1.2;
  background: transparent;
}

.bottom-tabbar .tab-icon {
  font-size: 34rpx;
  font-weight: 800;
}

.bottom-tabbar button.active {
  color: #159df2;
  background: #eaf7ff;
}

.time-limit-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(30, 45, 70, 0.56);
}

.time-limit-card {
  position: relative;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 50rpx 32rpx 32rpx;
  border-radius: 46rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(179, 229, 255, 0.72), transparent 28%),
    linear-gradient(180deg, #fbfdff 0%, #f4f8ff 100%);
  box-shadow: 0 40rpx 100rpx rgba(10, 28, 60, 0.28);
}

.time-limit-close {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  display: grid;
  place-items: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: #4b5563;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.time-limit-close::after,
.time-limit-actions button::after,
.time-limit-member::after {
  display: none;
}

.time-limit-hero {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  gap: 24rpx;
  align-items: center;
  padding-right: 70rpx;
}

.time-limit-avatar {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #fff0dc 0%, #dff3ff 70%);
}

.time-limit-avatar::before {
  content: "";
  position: absolute;
  left: 50rpx;
  top: 24rpx;
  width: 88rpx;
  height: 64rpx;
  border-radius: 52% 48% 42% 44%;
  background: #7b3f24;
  box-shadow:
    -20rpx 20rpx 0 -12rpx #7b3f24,
    24rpx 20rpx 0 -12rpx #7b3f24,
    6rpx -8rpx 0 -3rpx #8d4a2b;
}

.time-limit-avatar::after {
  content: "";
  position: absolute;
  left: 56rpx;
  top: 62rpx;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #ffd6bf;
  box-shadow:
    inset 16rpx 0 0 rgba(255, 232, 218, 0.8),
    44rpx 40rpx 0 -22rpx #ffd54c,
    -42rpx 50rpx 0 -24rpx #ffd54c;
}

.time-limit-avatar view {
  position: absolute;
  left: 52rpx;
  bottom: 24rpx;
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx 22rpx 42rpx 42rpx;
  background: linear-gradient(180deg, #36b8ff, #1688ec);
}

.time-limit-avatar view::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: 8rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  transform: rotate(18deg);
  background: linear-gradient(135deg, #ffe46b, #ffb22e);
}

.time-limit-copy {
  display: grid;
  gap: 12rpx;
}

.time-limit-heading {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 46rpx;
  font-weight: 900;
  color: #2f3848;
  line-height: 1.1;
}

.time-limit-heading text:last-child {
  color: #ff4f6f;
}

.time-limit-subtitle {
  color: #5d6675;
  font-size: 28rpx;
  font-weight: 700;
}

.time-limit-pill {
  justify-self: start;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #5f6b7a;
  font-size: 22rpx;
}

.time-limit-title {
  margin: 40rpx 0 24rpx;
  text-align: center;
  color: #303846;
  font-size: 32rpx;
  font-weight: 900;
}

.time-limit-actions {
  display: grid;
  gap: 18rpx;
}

.time-limit-actions button,
.time-limit-member {
  display: grid;
  grid-template-columns: 88rpx 1fr auto;
  gap: 18rpx;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #fff;
  text-align: left;
  box-shadow: 0 18rpx 54rpx rgba(28, 42, 68, 0.08);
}

.limit-icon {
  display: grid;
  place-items: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4fc3ff, #1688ff);
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.limit-icon.ad {
  background: linear-gradient(135deg, #b982ff, #7c4dff);
}

.limit-icon.crown {
  background: linear-gradient(135deg, #ffd971, #f0a22a);
}

.time-limit-actions button view,
.time-limit-member view {
  display: grid;
  gap: 8rpx;
}

.time-limit-actions button view text:first-child,
.time-limit-member view text:first-child {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.time-limit-actions button view text:last-child,
.time-limit-member view text:last-child {
  color: #7a8494;
  font-size: 22rpx;
}

.limit-reward {
  color: #ff8500;
  font-size: 25rpx;
  font-weight: 900;
}

.limit-task-side {
  display: grid;
  gap: 10rpx;
  justify-items: end;
}

.limit-action {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #1688ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.limit-action.purple {
  background: #855cff;
}

.time-limit-divider {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 20rpx;
  align-items: center;
  margin: 28rpx 0 22rpx;
  color: #8a94a6;
}

.time-limit-divider::before,
.time-limit-divider::after {
  content: "";
  height: 1rpx;
  border-top: 1rpx dashed #d5dce8;
}

.time-limit-member {
  background: linear-gradient(90deg, #fff7e8, #fff0d0);
  border: 1rpx solid #ffe1a8;
  grid-template-columns: 88rpx 1fr auto;
}

.time-limit-member > text:last-child {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #f3c268;
  color: #70470a;
  font-size: 24rpx;
  font-weight: 900;
}

.time-limit-safe {
  margin-top: 22rpx;
  text-align: center;
  color: #8a94a6;
  font-size: 24rpx;
}

.task-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 30rpx;
  background: rgba(30, 45, 70, 0.52);
}

.task-sheet {
  position: relative;
  width: 100%;
  padding: 42rpx 30rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fbfdff 0%, #f4f8ff 100%);
  box-shadow: 0 34rpx 90rpx rgba(10, 28, 60, 0.26);
}

.task-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: grid;
  place-items: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: #4b5563;
  font-size: 44rpx;
  font-weight: 900;
}

.task-close::after,
.task-primary::after {
  display: none;
}

.task-hero {
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 22rpx;
  align-items: center;
  padding-right: 72rpx;
}

.task-icon {
  display: grid;
  place-items: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4fc3ff, #1688ff);
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
}

.task-icon.ad {
  background: linear-gradient(135deg, #b982ff, #7c4dff);
}

.task-icon.crown {
  background: linear-gradient(135deg, #ffd971, #f0a22a);
}

.task-hero view {
  display: grid;
  gap: 8rpx;
}

.task-hero view text:first-child {
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
}

.task-hero view text:last-child {
  color: #ff8500;
  font-size: 26rpx;
  font-weight: 900;
}

.task-copy {
  margin: 26rpx 0 22rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.7;
}

.task-steps {
  display: grid;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.task-steps text,
.task-video,
.task-member-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #344054;
  font-size: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(28, 42, 68, 0.06);
}

.task-video {
  display: grid;
  place-items: center;
  height: 220rpx;
  margin-bottom: 26rpx;
  border: 2rpx dashed #b8dcff;
  color: #159df2;
}

.task-member-card {
  display: grid;
  gap: 8rpx;
  margin-bottom: 26rpx;
  background: linear-gradient(90deg, #fff7e8, #fff0d0);
  border: 1rpx solid #ffe1a8;
}

.task-member-card text:first-child {
  color: #5b3600;
  font-size: 30rpx;
  font-weight: 900;
}

.task-member-card text:last-child {
  color: #8a651f;
}

.task-primary {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #1688ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.task-primary.purple {
  background: #855cff;
}

.task-primary.gold {
  background: #f3c268;
  color: #70470a;
}
