/* 我的页面样式 */
.my-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 18% 6%, rgba(169, 237, 255, 0.86), transparent 34%),
    linear-gradient(180deg, #e9f8ff 0%, #f7f8fa 48%, #f7f8fa 100%);
  box-sizing: border-box;
}

.my-content {
  padding: 0 28rpx 42rpx;
}

/* 用户信息卡片 */
.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
  overflow: hidden;
}

.avatar-img {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f0f7ff;
  flex: 0 0 auto;
}

.profile-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.profile-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #121826;
}

.profile-subtitle {
  font-size: 22rpx;
  color: #667085;
}

.login-btn {
  flex: 0 0 auto;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #4cc6ff, #1688ff);
}

.profile-deco {
  position: absolute;
  right: 18rpx;
  bottom: -8rpx;
  width: 90rpx;
  height: 90rpx;
  opacity: 0.14;
  pointer-events: none;
}

/* 使用时长卡片 */
.usage-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
}

.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title-main {
  font-size: 28rpx;
  font-weight: 900;
  color: #1f2937;
}

.card-title-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #98a2b3;
  font-size: 24rpx;
}

.arrow {
  font-size: 26rpx;
  color: #c4cbd6;
}

.usage-content {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-top: 28rpx;
}

.usage-ring-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.usage-ring {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.usage-ring-inner {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-minutes {
  font-size: 42rpx;
  font-weight: 900;
  color: #1f2937;
  line-height: 1;
}

.ring-unit {
  font-size: 20rpx;
  color: #667085;
  margin-top: 4rpx;
}

.ring-label {
  font-size: 22rpx;
  color: #24a9ff;
  font-weight: 600;
}

.usage-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.usage-today {
  font-size: 24rpx;
  color: #344054;
}

.usage-bar {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef5ff;
}

.usage-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #24a9ff, #118cff);
}

.usage-total {
  align-self: flex-end;
  font-size: 22rpx;
  color: #667085;
}

.usage-actions {
  display: flex;
  gap: 14rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f5fbff;
  text-align: left;
  box-sizing: border-box;
}

.action-btn image {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 auto;
}

.action-btn view {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.action-btn view text:first-child {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2937;
}

.action-btn .reward {
  font-size: 20rpx;
  color: #667085;
}

/* 兑换会员 */
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  color: #7a4a09;
  text-align: left;
  background: linear-gradient(90deg, #fff8e8, #fff1d4);
  box-sizing: border-box;
}

.member-icon {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.member-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.member-copy text:first-child {
  font-size: 28rpx;
  font-weight: 900;
  color: #7a4a09;
}

.member-copy text:last-child {
  font-size: 22rpx;
  color: #b38942;
}

.member-more {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #7a4a09;
  font-size: 24rpx;
  font-weight: 600;
}

/* 菜单列表 */
.my-menu {
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(38, 80, 120, 0.08);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 92rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f5f6f8;
  background: #fff;
  text-align: left;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-wrap.gift {
  background: #fff3e8;
}

.menu-icon-wrap.coin {
  background: #fff3e8;
}

.menu-icon-wrap.record {
  background: #e8fffd;
}

.menu-icon-wrap.clock {
  background: #eff1ff;
}

.menu-icon-wrap.chart {
  background: #e8fffd;
}

.menu-icon-wrap.gear {
  background: #e8f5ff;
}

.menu-icon {
  width: 28rpx;
  height: 28rpx;
}

.menu-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu-aside {
  flex: 0 0 auto;
  color: #ff7a2d;
  font-size: 24rpx;
  font-weight: 600;
}

.menu-arrow {
  flex: 0 0 auto;
  color: #c4cbd6;
  font-size: 26rpx;
}

/* 按钮伪元素清除 */
.profile-card button::after,
.action-btn::after,
.menu-item::after,
.bottom-tabbar .tab-item::after {
  display: none;
}

/* 免费时长弹窗 */
.time-limit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(30, 45, 70, 0.56);
}

.time-limit-card {
  position: relative;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 50rpx 32rpx 32rpx;
  border-radius: 46rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(179, 229, 255, 0.72), transparent 28%),
    linear-gradient(180deg, #fbfdff 0%, #f4f8ff 100%);
  box-shadow: 0 40rpx 100rpx rgba(10, 28, 60, 0.28);
}

.time-limit-close {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 0;
  background: transparent;
  color: #4b5563;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.time-limit-actions button::after,
.time-limit-member::after {
  display: none;
}

.time-limit-hero {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding-right: 70rpx;
}

.time-limit-avatar {
  flex: 0 0 184rpx;
}

.time-limit-avatar {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #fff0dc 0%, #dff3ff 70%);
}

.time-limit-avatar::before {
  content: "";
  position: absolute;
  left: 50rpx;
  top: 24rpx;
  width: 88rpx;
  height: 64rpx;
  border-radius: 52% 48% 42% 44%;
  background: #7b3f24;
  box-shadow:
    -20rpx 20rpx 0 -12rpx #7b3f24,
    24rpx 20rpx 0 -12rpx #7b3f24,
    6rpx -8rpx 0 -3rpx #8d4a2b;
}

.time-limit-avatar::after {
  content: "";
  position: absolute;
  left: 56rpx;
  top: 62rpx;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #ffd6bf;
  box-shadow:
    inset 16rpx 0 0 rgba(255, 232, 218, 0.8),
    44rpx 40rpx 0 -22rpx #ffd54c,
    -42rpx 50rpx 0 -24rpx #ffd54c;
}

.time-limit-avatar view {
  position: absolute;
  left: 52rpx;
  bottom: 24rpx;
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx 22rpx 42rpx 42rpx;
  background: linear-gradient(180deg, #36b8ff, #1688ec);
}

.time-limit-avatar view::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: 8rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  transform: rotate(18deg);
  background: linear-gradient(135deg, #ffe46b, #ffb22e);
}

.time-limit-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.time-limit-heading {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 46rpx;
  font-weight: 900;
  color: #2f3848;
  line-height: 1.1;
}

.time-limit-heading text:last-child {
  color: #ff4f6f;
}

.time-limit-subtitle {
  color: #5d6675;
  font-size: 28rpx;
  font-weight: 700;
}

.time-limit-pill {
  align-self: flex-start;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #5f6b7a;
  font-size: 22rpx;
}

.time-limit-title {
  margin: 40rpx 0 24rpx;
  text-align: center;
  color: #303846;
  font-size: 32rpx;
  font-weight: 900;
}

.time-limit-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.time-limit-actions button,
.time-limit-member {
  display: flex;
  gap: 18rpx;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #fff;
  text-align: left;
  box-shadow: 0 18rpx 54rpx rgba(28, 42, 68, 0.08);
  box-sizing: border-box;
}

.limit-icon {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4fc3ff, #1688ff);
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.limit-icon.ad {
  background: linear-gradient(135deg, #b982ff, #7c4dff);
}

.limit-icon.crown {
  background: linear-gradient(135deg, #ffd971, #f0a22a);
}

.time-limit-actions button view,
.time-limit-member view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.time-limit-actions button view text:first-child,
.time-limit-member view text:first-child {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.time-limit-actions button view text:last-child,
.time-limit-member view text:last-child {
  color: #7a8494;
  font-size: 22rpx;
}

.limit-reward {
  color: #ff8500;
  font-size: 25rpx;
  font-weight: 900;
}

.limit-task-side {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-end;
  flex: 0 0 auto;
}

.limit-action {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #1688ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.limit-action.purple {
  background: #855cff;
}

.time-limit-divider {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin: 28rpx 0 22rpx;
  color: #8a94a6;
}

.time-limit-divider::before,
.time-limit-divider::after {
  flex: 1;
  content: "";
  height: 1rpx;
  border-top: 1rpx dashed #d5dce8;
}

.time-limit-member {
  background: linear-gradient(90deg, #fff7e8, #fff0d0);
  border: 1rpx solid #ffe1a8;
}

.time-limit-member > text:last-child {
  flex: 0 0 auto;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #f3c268;
  color: #70470a;
  font-size: 24rpx;
  font-weight: 900;
}

.time-limit-safe {
  margin-top: 22rpx;
  text-align: center;
  color: #8a94a6;
  font-size: 24rpx;
}

/* 任务弹窗 */
.task-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: rgba(30, 45, 70, 0.52);
}

.task-sheet {
  position: relative;
  width: 100%;
  padding: 42rpx 30rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fbfdff 0%, #f4f8ff 100%);
  box-shadow: 0 34rpx 90rpx rgba(10, 28, 60, 0.26);
}

.task-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 0;
  background: transparent;
  color: #4b5563;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.task-primary::after {
  display: none;
}

.task-hero {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding-right: 72rpx;
}

.task-hero .task-icon {
  flex: 0 0 auto;
}

.task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4fc3ff, #1688ff);
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
}

.task-icon.ad {
  background: linear-gradient(135deg, #b982ff, #7c4dff);
}

.task-icon.crown {
  background: linear-gradient(135deg, #ffd971, #f0a22a);
}

.task-hero view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.task-hero view text:first-child {
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
}

.task-hero view text:last-child {
  color: #ff8500;
  font-size: 26rpx;
  font-weight: 900;
}

.task-copy {
  margin: 26rpx 0 22rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.7;
}

.task-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.task-steps text,
.task-video,
.task-member-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #344054;
  font-size: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(28, 42, 68, 0.06);
}

.task-video {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  margin-bottom: 26rpx;
  border: 2rpx dashed #b8dcff;
  color: #159df2;
}

.task-member-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 26rpx;
  background: linear-gradient(90deg, #fff7e8, #fff0d0);
  border: 1rpx solid #ffe1a8;
}

.task-member-card text:first-child {
  color: #5b3600;
  font-size: 30rpx;
  font-weight: 900;
}

.task-member-card text:last-child {
  color: #8a651f;
}

.task-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  background: #1688ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.task-primary.purple {
  background: #855cff;
}

.task-primary.gold {
  background: #f3c268;
  color: #70470a;
}

/* 套餐选择列表 */
.plan-select-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.plan-select-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #f0e5d0;
  transition: border-color 0.2s;
}

.plan-select-item.active {
  border-color: #f3c268;
  background: #fffdf6;
}

.plan-select-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d4c5a0;
  flex: 0 0 auto;
}

.plan-select-radio.checked {
  border-color: #f3c268;
  background: #f3c268;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.plan-select-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.plan-select-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #5b3600;
}

.plan-select-price {
  font-size: 24rpx;
  color: #8a651f;
}

.redeem-code-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: 0 0 22rpx;
  padding: 0 24rpx;
  border: 2rpx solid #ffe1a8;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
}

.redeem-code-box input {
  width: 100%;
  height: 100%;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 底部导航栏 */
.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #f0f2f5;
  background: #fff;
  box-sizing: border-box;
}

.bottom-tabbar .tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1;
  background: transparent;
  min-width: 0;
}

.bottom-tabbar .tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.bottom-tabbar .tab-item.active {
  color: #1688ff;
}
