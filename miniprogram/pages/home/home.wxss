/* 首页样式 */
.home-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.home-hero {
  position: relative;
  padding-bottom: 120rpx;
  background: linear-gradient(180deg, #d7f8ff 0%, #e9f8ff 60%, #f7f8fa 100%);
  overflow: hidden;
}

.home-logo {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.logo-text {
  color: #168ed2;
  font-size: 34rpx;
  font-weight: 900;
  font-style: italic;
}

.logo-plus {
  color: #168ed2;
  font-size: 28rpx;
  font-weight: 800;
}

.hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 48rpx 0;
}

.book-card {
  position: relative;
  width: 380rpx;
  height: 480rpx;
  border-radius: 24rpx;
  box-shadow: 0 28rpx 60rpx rgba(42, 111, 156, 0.24);
  overflow: hidden;
}

.book-card image,
.cover-empty {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: #fff;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c8797;
  font-size: 28rpx;
  font-weight: 600;
}

.book-switch {
  position: absolute;
  right: 0;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx 14rpx 28rpx;
  border-radius: 28rpx 0 0 28rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.book-switch::after,
.primary::after,
.quick-item::after,
.bottom-tabbar .tab-item::after {
  display: none;
}

.book-switch .arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.reader-action {
  position: relative;
  width: calc(100vw - 48rpx);
  max-width: 704rpx;
  margin-top: 72rpx;
}

.primary {
  width: 100%;
  height: 104rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2db3ff, #1688ff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(22, 136, 255, 0.3);
  box-sizing: border-box;
}

.progress-badge {
  position: absolute;
  right: 0;
  top: -22rpx;
  z-index: 3;
  min-width: 136rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ff6a21;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(255, 106, 33, 0.3);
}

.panel {
  margin: -80rpx 28rpx 36rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(38, 80, 120, 0.08);
}

.panel-title {
  display: block;
  color: #7a8494;
  font-weight: 700;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.quick-grid {
  display: flex;
  gap: 20rpx;
}

.quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 12rpx;
  border-radius: 20rpx;
  background: #f8edf9;
  color: #111827;
  font-weight: 700;
  font-size: 26rpx;
  box-sizing: border-box;
}

.quick-item.alphabet {
  background: #fff0ef;
}

.quick-item.phonics {
  background: #fff6e6;
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.icon-phonetics {
  color: #a855c2;
  font-size: 36rpx;
  font-weight: 800;
}

.icon-alphabet {
  color: #ff6b6b;
  font-size: 40rpx;
  font-weight: 800;
}

.icon-phonics {
  color: #f5a623;
  font-size: 30rpx;
  font-weight: 800;
}

/* 底部导航栏 */
.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #f0f2f5;
  background: #fff;
  box-sizing: border-box;
}

.bottom-tabbar .tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1;
  background: transparent;
  min-width: 0;
}

.bottom-tabbar .tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.bottom-tabbar .tab-item.active {
  color: #1688ff;
}
