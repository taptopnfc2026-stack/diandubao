@import "../reader/reader.wxss";

.compact-nav {
  height: 116rpx;
  padding-top: 0;
}

.phonetic-detail {
  min-height: calc(100vh - 116rpx);
  padding: 32rpx 80rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
  background: #fff;
}

.detail-symbol {
  color: #20a8ff;
  font-size: 128rpx;
  line-height: 1;
}

.audio-actions {
  display: flex;
  gap: 60rpx;
}

.audio-actions button {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #eef8ff;
  color: #20a8ff;
}

.figure {
  width: 100%;
  overflow: hidden;
  border-radius: 16rpx;
  background: #c8f5ff;
  text-align: center;
}

.figure image {
  width: 100%;
  height: 230rpx;
  display: block;
}

.figure text {
  display: block;
  padding: 20rpx;
  color: #4b5563;
  font-size: 44rpx;
  font-weight: 800;
}

.explain {
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #e6e6e6;
  line-height: 1.45;
}
