/* 音标详情页样式 */
.phonetic-detail-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.phonetic-detail {
  flex: 1;
  min-height: 0;
  padding: 32rpx 48rpx calc(64rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
  background: #fff;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-symbol {
  color: #20a8ff;
  font-size: 128rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-subtitle {
  font-size: 32rpx;
  color: #4b5563;
  font-weight: 600;
}

.audio-actions {
  display: flex;
  gap: 60rpx;
}

.audio-actions view {
  width: 72rpx;
  height: 72rpx;
  border-radius: 0;
  background: transparent;
  color: #20a8ff;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.figure {
  width: 100%;
  max-width: 560rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #e8f8ff, #d7f8ff);
  text-align: center;
  box-sizing: border-box;
}

.figure image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.figure text {
  display: block;
  padding: 24rpx;
  color: #168ed2;
  font-size: 44rpx;
  font-weight: 800;
}

.explain {
  width: 100%;
  max-width: 560rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
