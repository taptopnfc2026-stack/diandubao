/* 全局样式 - 小程序适配 */

page {
  min-height: 100%;
  background: #f7f8fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

/* 统一重置 button 默认样式，防止小程序 button 撑宽/溢出 */
button {
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: none;
  font: inherit;
  color: inherit;
  box-sizing: border-box;
  min-width: 0;
  line-height: 1.2;
}

button::after {
  border: 0;
  display: none;
}

/* 统一使用 border-box */
view,
text,
image,
button,
scroll-view,
navigator {
  box-sizing: border-box;
}

/* 底部安全区适配 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部安全区适配（用于不需要 nav-bar 的特殊区域） */
.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
